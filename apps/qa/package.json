{
  "name": "qa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Suite de pruebas automatizadas de QA para Sabor y Gestión (E2E & API)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.11.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.57.0"
  }
}
