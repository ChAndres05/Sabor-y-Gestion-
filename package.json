{
  "name": "sabor-gestion-tis",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "test:qa": "pnpm --filter qa test",
    "test:qa:ui": "pnpm --filter qa test:ui",
    "test:qa:headed": "pnpm --filter qa test:headed",
    "test:qa:report": "pnpm --filter qa test:report"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.9.1"
  }
}